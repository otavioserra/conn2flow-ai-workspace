{
  "name": "conn2flow-tools",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "conn2flow",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/otavioserra/conn2flow-ai-workspace"
  },
  "homepage": "https://conn2flow.com",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "conn2flow",
    "sdd",
    "docker",
    "tailwind",
    "ai"
  ],
  "activationEvents": [
    "onView:conn2flow-explorer"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Browsing and documentation remain available; command execution requires Workspace Trust.",
      "restrictedConfigurations": [
        "conn2flow.githubOwner"
      ]
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "conn2flow-view-container",
          "title": "%view.title%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "conn2flow-view-container": [
        {
          "id": "conn2flow-explorer",
          "name": "%view.title%"
        }
      ]
    },
    "commands": [
      {
        "command": "conn2flow.refreshTree",
        "title": "%command.conn2flow.refreshTree%",
        "category": "Conn2Flow",
        "icon": "$(refresh)"
      },
      {
        "command": "conn2flow.expandAll",
        "title": "%command.conn2flow.expandAll%",
