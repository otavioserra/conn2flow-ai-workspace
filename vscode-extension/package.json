{
  "name": "conn2flow-tools",
  "displayName": "Conn2Flow Dev Tools",
  "description": "Painel oficial de desenvolvedor para o ecossistema Conn2Flow: controle visual de SDD, Modos de Agentes (Duplo/Tríade), Níveis de Autonomia, Docker, Core CLI, Projetos, Ações Customizadas (.c2f/actions.json) e AI Workspace Hub.",
  "version": "1.0.0",
  "publisher": "conn2flow",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/otavioserra/conn2flow-ai-workspace"
  },
  "homepage": "https://conn2flow.com",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "conn2flow",
    "sdd",
    "docker",
    "tailwind",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "conn2flow-view-container",
          "title": "Conn2Flow",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "conn2flow-view-container": [
        {
          "id": "conn2flow-explorer",
          "name": "Conn2Flow Dev Tools"
        }
      ]
    },
    "commands": [
      {
        "command": "conn2flow.refreshTree",
        "title": "Atualizar Painel",
        "category": "Conn2Flow",
        "icon": "$(refresh)"
      },
      {
        "command": "conn2flow.expandAll",
        "title": "Expandir Todas as Seções",
        "category": "Conn2Flow",
        "icon": "$(expand-all)"
      },
      {
        "command": "conn2flow.collapseAll",
        "title": "Colapsar Todas as Seções",
        "category": "Conn2Flow",
        "icon": "$(collapse-all)"
      },
      {
        "command": "conn2flow.terminal.toggleMode",
        "title": "Alternar Modo de Terminal (Reutilizar vs Novo)",
        "category": "Conn2Flow",
        "icon": "$(terminal)"
      },
      {
        "command": "conn2flow.custom.initManifest",
        "title": "Criar Ações Customizadas (.c2f/actions.json)",
        "category": "Conn2Flow Custom",
        "icon": "$(sparkle)"
      },
      {
        "command": "conn2flow.custom.editManifest",
        "title": "Editar Ações do Projeto (.c2f/actions.json)",
        "category": "Conn2Flow Custom",
        "icon": "$(edit)"
      },
      {
        "command": "conn2flow.modes.selectMode",
        "title": "Selecionar Topologia ou Autonomia",
        "category": "Conn2Flow Modos",
        "icon": "$(settings-gear)"
      },
      {
        "command": "conn2flow.modes.setDoubleAgent",
        "title": "Ativar Duplo Agente",
        "category": "Conn2Flow Modos",
        "icon": "$(person)"
      },
      {
        "command": "conn2flow.modes.setTriAgent",
        "title": "Ativar Tríade de Agentes",
        "category": "Conn2Flow Modos",
        "icon": "$(organization)"
      },
      {
        "command": "conn2flow.modes.setSupervised",
        "title": "Ativar Modo Supervisionado (Nível 1)",
        "category": "Conn2Flow Autonomia",
        "icon": "$(shield)"
      },
      {
        "command": "conn2flow.modes.setMonitored",
        "title": "Ativar Modo Autônomo Monitorado (Nível 2)",
        "category": "Conn2Flow Autonomia",
        "icon": "$(eye)"
      },
      {
        "command": "conn2flow.modes.setHeadless",
        "title": "Ativar Modo Autônomo Headless (Nível 3)",
        "category": "Conn2Flow Autonomia",
        "icon": "$(robot)"
      },
      {
        "command": "conn2flow.sdd.openCurrent",
        "title": "Abrir CURRENT.md (Preview)",
        "category": "Conn2Flow SDD",
        "icon": "$(file-text)"
      },
      {
        "command": "conn2flow.sdd.openSpec",
        "title": "Abrir SPEC.md (Preview)",
        "category": "Conn2Flow SDD",
        "icon": "$(file-code)"
      },
      {
        "command": "conn2flow.sdd.openChecklist",
        "title": "Abrir Checklist de Validação",
        "category": "Conn2Flow SDD",
        "icon": "$(checklist)"
      },
      {
        "command": "conn2flow.bridge.launchClaudeGoal",
        "title": "Iniciar Claude Code (/goal)",
        "category": "Conn2Flow Triad",
        "icon": "$(play-circle)"
      },
      {
        "command": "conn2flow.bridge.copyPrompt",
        "title": "Copiar Prompt do Executor",
        "category": "Conn2Flow Triad",
        "icon": "$(clippy)"
      },
      {
        "command": "conn2flow.bridge.recordHandoff",
        "title": "Registrar Log do Terminal (Handoff)",
        "category": "Conn2Flow Triad",
        "icon": "$(repo-pull)"
      },
      {
        "command": "conn2flow.bridge.notifyArchitect",
        "title": "Sincronizar e Notificar Arquiteto",
        "category": "Conn2Flow Triad",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "conn2flow.docker.status",
        "title": "Status dos Containers",
        "category": "Conn2Flow Docker",
        "icon": "$(pulse)"
      },
      {
        "command": "conn2flow.docker.logsApache",
        "title": "Logs Apache (Follow)",
        "category": "Conn2Flow Docker",
        "icon": "$(output)"
      },
      {
        "command": "conn2flow.docker.logsPhp",
        "title": "Logs PHP (Follow)",
        "category": "Conn2Flow Docker",
        "icon": "$(terminal)"
      },
      {
        "command": "conn2flow.docker.truncatePhpLog",
        "title": "Limpar Logs PHP",
        "category": "Conn2Flow Docker",
        "icon": "$(trash)"
      },
      {
        "command": "conn2flow.manager.updateAll",
        "title": "Update All (Sistema)",
        "category": "Conn2Flow Manager",
        "icon": "$(sync)"
      },
      {
        "command": "conn2flow.manager.syncResources",
        "title": "Sincronizar Recursos",
        "category": "Conn2Flow Manager",
        "icon": "$(paintcan)"
      },
      {
        "command": "conn2flow.manager.cssRebuild",
        "title": "CSS Rebuild",
        "category": "Conn2Flow Manager",
        "icon": "$(zap)"
      },
      {
        "command": "conn2flow.manager.cssAudit",
        "title": "CSS Audit",
        "category": "Conn2Flow Manager",
        "icon": "$(search)"
      },
      {
        "command": "conn2flow.projects.setTarget",
        "title": "Definir Projeto Alvo Padrão",
        "category": "Conn2Flow Projetos",
        "icon": "$(target)"
      },
      {
        "command": "conn2flow.projects.deployTarget",
        "title": "Deploy Projeto Alvo",
        "category": "Conn2Flow Projetos",
        "icon": "$(rocket)"
      },
      {
        "command": "conn2flow.projects.deployWithSelect",
        "title": "Deploy Escolhendo Projeto...",
        "category": "Conn2Flow Projetos",
        "icon": "$(list-selection)"
      },
      {
        "command": "conn2flow.projects.updateAllTarget",
        "title": "Update All Projeto Alvo",
        "category": "Conn2Flow Projetos",
        "icon": "$(refresh)"
      },
      {
        "command": "conn2flow.projects.updateAllWithSelect",
        "title": "Update All Escolhendo Projeto...",
        "category": "Conn2Flow Projetos",
        "icon": "$(list-ordered)"
      },
      {
        "command": "conn2flow.projects.addNew",
        "title": "Cadastrar Novo Projeto no Environment",
        "category": "Conn2Flow Projetos",
        "icon": "$(add)"
      },
      {
        "command": "conn2flow.projects.scaffoldProject",
        "title": "Provisionar Novo Projeto Satélite",
        "category": "Conn2Flow Projetos",
        "icon": "$(repo-create)"
      },
      {
        "command": "conn2flow.projects.cloneRepository",
        "title": "Clonar Repositórios Oficiais",
        "category": "Conn2Flow Projetos",
        "icon": "$(cloud-download)"
      },
      {
        "command": "conn2flow.projects.checkRepositories",
        "title": "Verificar Repositórios Clonados",
        "category": "Conn2Flow Projetos",
        "icon": "$(repo)"
      },
      {
        "command": "conn2flow.projects.syncTemplate",
        "title": "Sincronizar com Template do Core",
        "category": "Conn2Flow Projetos",
        "icon": "$(sync)"
      },
      {
        "command": "conn2flow.projects.openTemplate",
        "title": "Abrir Template do Environment",
        "category": "Conn2Flow Projetos",
        "icon": "$(file-submodule)"
      },
      {
        "command": "conn2flow.projects.openActive",
        "title": "Abrir environment.json (Ativo)",
        "category": "Conn2Flow Projetos",
        "icon": "$(file-text)"
      },
      {
        "command": "conn2flow.ai.syncSkills",
        "title": "Sincronizar Skills (1-Click)",
        "category": "Conn2Flow AI",
        "icon": "$(cloud-download)"
      },
      {
        "command": "conn2flow.ai.validateSkills",
        "title": "Validar 36 Skills (ai:sync)",
        "category": "Conn2Flow AI",
        "icon": "$(pass)"
      },
      {
        "command": "conn2flow.ai.openPlaybook",
        "title": "Abrir Playbook Multi-Agentes",
        "category": "Conn2Flow AI",
        "icon": "$(book)"
      },
      {
        "command": "conn2flow.ai.openCatalog",
        "title": "Abrir Catálogo de Skills",
        "category": "Conn2Flow AI",
        "icon": "$(list-unordered)"
      },
      {
        "command": "conn2flow.docs.openPanelGuide",
        "title": "Manual do Painel Dev Tools",
        "category": "Conn2Flow Docs",
        "icon": "$(file-text)"
      },
      {
        "command": "conn2flow.docs.openMarketplaceGuide",
        "title": "Guia de Publicação Marketplace",
        "category": "Conn2Flow Docs",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "conn2flow.docs.openArchitectureGuide",
        "title": "Arquitetura Agente Duplo e Tríade",
        "category": "Conn2Flow Docs",
        "icon": "$(organization)"
      },
      {
        "command": "conn2flow.docs.openDockerGuide",
        "title": "Guia de Ambiente Docker",
        "category": "Conn2Flow Docs",
        "icon": "$(server)"
      },
      {
        "command": "conn2flow.docs.openResourcesGuide",
        "title": "Sistema de Recursos e Runtime SQL",
        "category": "Conn2Flow Docs",
        "icon": "$(paintcan)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "conn2flow.expandAll",
          "when": "view == conn2flow-explorer",
          "group": "navigation@1"
        },
        {
          "command": "conn2flow.collapseAll",
          "when": "view == conn2flow-explorer",
          "group": "navigation@2"
        },
        {
          "command": "conn2flow.refreshTree",
          "when": "view == conn2flow-explorer",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
