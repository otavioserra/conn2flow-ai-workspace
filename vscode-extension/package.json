    "configuration": {
      "title": "Conn2Flow Dev Tools",
      "properties": {
        "conn2flow.language": {
          "type": "string",
          "enum": [
            "auto",
            "pt-BR",
            "en"
          ],
          "default": "auto",
          "scope": "window",
          "description": "%config.language.description%"
        },
        "conn2flow.githubOwner": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%config.githubOwner.description%"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "conn2flow.expandAll",
          "when": "view == conn2flow-explorer",
          "group": "navigation@1"
        },
        {
          "command": "conn2flow.collapseAll",
          "when": "view == conn2flow-explorer",
          "group": "navigation@2"
        },
        {
          "command": "conn2flow.refreshTree",
          "when": "view == conn2flow-explorer",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/**/*.test.cjs",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
