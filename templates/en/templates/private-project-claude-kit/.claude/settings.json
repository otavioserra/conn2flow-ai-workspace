{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "english",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: keep batches small and validation explicit.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/pre-tool-guard.ps1"
          }
        ]
      }
    ]
  }
}