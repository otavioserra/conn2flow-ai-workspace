{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "portuguese",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: numbered specs remain normative; classify human-requests before editing specs; keep batches small and validation explicit.'"
          }
        ]
      }
    ]
  }
}